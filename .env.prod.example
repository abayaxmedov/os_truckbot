# ---- Production environment (os_truckbot) ----
# On the server: cp .env.prod.example .env  then fill REAL values.
# NEVER commit .env. DATABASE_URL/SYNC are injected by docker-compose.prod.yml.

# Telegram
BOT_TOKEN=123456:your-bot-token-from-BotFather
TELEGRAM_ADMIN_IDS=              # your numeric Telegram id(s), comma-separated (grants admin)
MINIAPP_URL=https://3-227-184-179.sslip.io
PUBLIC_BASE_URL=https://3-227-184-179.sslip.io
BOT_MODE=webhook
WEBHOOK_SECRET=change-me-to-a-long-random-string

# App
ENV=prod
DEV_AUTH_BYPASS=false             # MUST be false in production
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_MINUTES=10080
DEFAULT_LANGUAGE=ru
CORS_ORIGINS=https://3-227-184-179.sslip.io

# Database — password used by both the db container and the backend connection string
POSTGRES_PASSWORD=change-me-strong-db-password

# Marketplace
DEFAULT_COMMISSION_PERCENT=7
DEFAULT_DELIVERY_COST=0
PAYOUT_PERIOD_DAYS=12

# Payments (stubs until merchant keys are provisioned)
CLICK_MERCHANT_ID=
CLICK_SECRET_KEY=
PAYME_MERCHANT_ID=
PAYME_SECRET_KEY=
UZUM_MERCHANT_ID=
UZUM_SECRET_KEY=
