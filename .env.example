# ---- Telegram ----
# Bot token from @BotFather (required to run the bot; API works without it)
BOT_TOKEN=
# Comma-separated Telegram numeric user IDs that get admin rights
TELEGRAM_ADMIN_IDS=
# Public HTTPS URL of the Mini App (BotFather → Web App). For local dev use a tunnel (cloudflared/ngrok).
MINIAPP_URL=https://localhost:5173
# Bot run mode: "polling" (dev) or "webhook" (prod)
BOT_MODE=polling
# Public base URL of the backend (used for webhook + media links), e.g. https://api.example.com
PUBLIC_BASE_URL=http://localhost:8010
# Webhook secret path segment (only for BOT_MODE=webhook)
WEBHOOK_SECRET=change-me-webhook-secret

# ---- App ----
ENV=dev
# Allow calling the API without valid Telegram initData (LOCAL DEV ONLY). Never enable in prod.
DEV_AUTH_BYPASS=true
JWT_SECRET=change-me-please-a-long-random-string
JWT_EXPIRES_MINUTES=10080
DEFAULT_LANGUAGE=ru
# CORS origins for the Mini App (comma separated)
CORS_ORIGINS=http://localhost:5173,https://localhost:5173

# ---- Database ----
DATABASE_URL=postgresql+asyncpg://truckbot:truckbot@localhost:5433/truckbot
# Sync URL used by Alembic
DATABASE_URL_SYNC=postgresql+psycopg://truckbot:truckbot@localhost:5433/truckbot

# ---- Marketplace ----
DEFAULT_COMMISSION_PERCENT=7
DEFAULT_DELIVERY_COST=0

# ---- Payments (stubs; real keys added later) ----
CLICK_MERCHANT_ID=
CLICK_SECRET_KEY=
PAYME_MERCHANT_ID=
PAYME_SECRET_KEY=
UZUM_MERCHANT_ID=
UZUM_SECRET_KEY=
